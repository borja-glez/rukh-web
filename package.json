{
  "name": "rukh-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Play against the Rukh chess language model in the browser",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "lighthouse": "pnpm lighthouse:mobile && pnpm lighthouse:desktop",
    "lighthouse:mobile": "lhci autorun --config=lighthouserc.json",
    "lighthouse:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sync:tokenizer": "node scripts/sync-tokenizer.mjs",
    "tokens:hash": "node scripts/tokens-hash.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@preact/signals": "^2.11.2",
    "astro": "7.3.3",
    "chess.js": "1.4.0",
    "cm-chessboard": "8.14.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "^17.12.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
