{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["astro/client"],
    "allowJs": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "e2e/**/*", "*.ts", "*.mjs"],
  "exclude": ["dist", "node_modules"]
}
